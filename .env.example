# Claude is the main service. The page has a switch between Claude and OpenRouter
# (the CLI takes --provider claude|openrouter); fill in the key of each one you use.

# --- Main: Claude. Create the key in the Claude Console (console.anthropic.com). ---
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# The page's menu also offers claude-sonnet-5-5 (faster), claude-haiku-5-5 (fastest,
# cheapest), and claude-fable-5-1 (most capable, slow: raise LLM_TOTAL_TIMEOUT for it).
# How hard Claude thinks while rewriting: low, medium (default), high, xhigh, or max.
# CLAUDE_THINKING_EFFORT=medium
# CLAUDE_MAX_TOKENS=32000

# --- Alternative: any service that speaks the standard Chat Completions format
# (OpenRouter, NVIDIA, and others). Keep one of the two blocks below active. ---

# Gemini 3.8 Flash through OpenRouter (about 2 cents per resume)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.8-flash
# Larger alternatives: google/gemini-3.1-pro-preview, anthropic/claude-opus-5.5
LLM_MAX_TOKENS=32000

# Or GLM 5.3 on NVIDIA's free trial API (slower). Check NVIDIA's terms
# before sending resumes: they contain personal data.
# LLM_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=z-ai/glm-5.3
# LLM_MAX_TOKENS=16384

# Shared by both services (defaults shown). NVIDIA_ENABLE_THINKING only affects NVIDIA models.
# LLM_TIMEOUT=300
# LLM_TOTAL_TIMEOUT=360
NVIDIA_ENABLE_THINKING=0

# Save each finished resume into this folder from the server, with no browser Save dialog
# (useful when a script or an AI drives the page). Unset: the browser downloads the file.
# `~` and `$HOME` are expanded; a relative path starts from the project folder.
# RESUME_SAVE_DIR=~/Downloads
