# Keep one block active. Any service that speaks the standard Chat Completions
# format works (OpenRouter, NVIDIA, and others).

# --- Main: Gemini 3.8 Flash through OpenRouter (about 2 cents per resume) ---
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.8-flash
# Larger alternatives: google/gemini-3.1-pro-preview, anthropic/claude-opus-5.5
LLM_MAX_TOKENS=32000

# --- Backup: GLM 5.3 on NVIDIA's free trial API (slower). Check NVIDIA's terms
# before sending resumes: they contain personal data. ---
# LLM_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=z-ai/glm-5.3
# LLM_MAX_TOKENS=16384

# Shared settings (defaults shown). NVIDIA_ENABLE_THINKING only affects NVIDIA models.
# LLM_TIMEOUT=300
# LLM_TOTAL_TIMEOUT=360
NVIDIA_ENABLE_THINKING=0
