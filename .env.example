# Any OpenAI-compatible Chat Completions endpoint. Keep one block uncommented.
OPENAI_API_KEY=

# Recommended: OpenRouter, one key for Claude, Gemini, and GPT models.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Best writing quality (about $0.15 per resume):
OPENAI_MODEL=anthropic/claude-opus-5.5
# Cheaper and faster (about $0.03 per resume):
# OPENAI_MODEL=google/gemini-3.8-flash
OPENAI_MAX_TOKENS=32000

# Free NVIDIA trial API (build.nvidia.com). Check NVIDIA's terms before sending
# resumes: they contain personal data.
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=z-ai/glm-5.3
# OPENAI_MAX_TOKENS=16384
# NVIDIA_ENABLE_THINKING=0

# OpenAI directly: leave OPENAI_MAX_TOKENS unset (newer models reject it).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-sol

# Seconds per attempt, and total wait including retries (defaults shown):
# OPENAI_TIMEOUT=300
# OPENAI_TOTAL_TIMEOUT=360
